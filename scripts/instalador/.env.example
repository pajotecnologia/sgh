# =============================================================================
# SGH — Copie este ficheiro para .env na raiz do site (mesma pasta que index.html)
# Apenas estes campos são obrigatórios para começar:
# =============================================================================

# PostgreSQL — ajuste usuário, senha, host e nome do banco
DATABASE_URL="postgresql://sgh_user:SUA_SENHA_AQUI@127.0.0.1:5432/sgh_db"

# URL pública do site (sem barra no final)
NEXTAUTH_URL="https://sgh.pajotech.com.br"

# --- Gerados automaticamente pelo instalar.sh (pode deixar vazio) ---
NEXTAUTH_SECRET=""
ENCRYPTION_KEY=""

NODE_ENV="production"
PORT="3000"
HOSTNAME="0.0.0.0"
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE="10485760"

# Pusher (opcional)
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="us2"
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="us2"

HOSPITAL_NOME="Hospital Municipal"
LOG_LEVEL="info"
