  @@index([status])
  @@index([createdAt])
  @@map("fichas_ccih")
}

/// Ficha de avaliação multidisciplinar durante a internação
model FichaMultidisciplinar {
  id                    String                      @id @default(uuid())
  atendimentoId         String                      @unique
  status                StatusFichaMultidisciplinar @default(RASCUNHO)
  nomePaciente          String?
  numeroProntuario      String?
  dataNascimento        DateTime?
  sexo                  String?
  setorUnidade          String?
  leitoDescricao        String?
  dataInternacao        DateTime?
  diagnosticoPrincipal  String?
  cidPrincipal          String?
  medico                Json?
  enfermagem            Json?
  nutricao              Json?
  fisioterapia          Json?
  psicologia            Json?
  farmacia              Json?
  planoConjunto         Json?
  preenchidoPorId       String?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  atendimento           Atendimento                 @relation(fields: [atendimentoId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdAt])
  @@map("fichas_multidisciplinares")
}

/// Ficha de evolução por turno (diurna / noturna) na internação
model FichaEvolucaoTurno {
  id                         String                   @id @default(uuid())
  atendimentoId              String
  turno                      TurnoEvolucaoInternacao
  dataReferencia             DateTime
  status                     StatusFichaEvolucaoTurno @default(RASCUNHO)
  nomePaciente               String?
  numeroProntuario           String?
  setorUnidade               String?
  leitoDescricao             String?
  estadoGeral                String?
  evolucaoClinica            String?
  exameFisico                String?
  sinaisVitais               Json?
  avaliacaoSistemas          Json?
  dietaEliminacoes           String?
  medicamentosProcedimentos  String?
  intercorrencias            String?
  condutaProximoTurno        String?
  nomeProfissional           String?
  conselhoProfissional       String?
  funcaoProfissional         String?
  preenchidoPorId            String?
  registradoEm               DateTime?
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  atendimento                Atendimento              @relation(fields: [atendimentoId], references: [id], onDelete: Cascade)

  @@unique([atendimentoId, dataReferencia, turno])
  @@index([atendimentoId])
  @@index([turno])
  @@index([dataReferencia])
  @@map("fichas_evolucao_turno")
}

/// Ficha de sinais vitais (controle horário 24h + balanço hídrico) — uma por dia
model FichaSinaisVitais {
  id               String    @id @default(uuid())
  atendimentoId    String
  dataReferencia   DateTime
  nomePaciente     String?
  numeroProntuario String?
  leitoDescricao   String?
  /// Grid horário: { "PRESSAO_ARTERIAL": { "7": "120/80", ... }, "PULSO": {...}, ... }
  controleHorario  Json?
  /// Balanço hídrico ganhos/perdas: { "ganhos": { "S_FISIOLOGICO": {...} }, "perdas": {...} }
  balancoHidrico   Json?
  preenchidoPorId  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  atendimento      Atendimento @relation(fields: [atendimentoId], references: [id], onDelete: Cascade)

  @@unique([atendimentoId, dataReferencia])
  @@index([atendimentoId])
  @@index([dataReferencia])
  @@map("fichas_sinais_vitais")
}

/// Ficha SAE — Sistematização da Assistência de Enfermagem — uma por dia
model FichaSae {
  id               String    @id @default(uuid())
  atendimentoId    String
  dataReferencia   DateTime
  nomePaciente     String?
  numeroProntuario String?
  leitoDescricao   String?
  /// Seleções de checkbox/radio agrupadas por chave: { "estadoGeral": ["REGULAR"], "pupilas": [...], ... }
  selecoes         Json?
  /// Campos de texto inline e complementos: { "febrilTemp": "38", "feridaLocal": "...", ... }
  textos           Json?
  /// Diagnósticos de enfermagem selecionados (lista de chaves)
  diagnosticos     Json?
  /// Prescrições de enfermagem selecionadas (lista de chaves) + valores inline
  prescricoes      Json?
  registroDiurno   String?
  registroNoturno  String?
  preenchidoPorId  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  atendimento      Atendimento @relation(fields: [atendimentoId], references: [id], onDelete: Cascade)

  @@unique([atendimentoId, dataReferencia])
  @@index([atendimentoId])
  @@index([dataReferencia])
  @@map("fichas_sae")
}

/// Ficha de evolução multiprofissional — log cronológico (append-only) por atendimento
model EvolucaoMultiprofissional {
  id               String    @id @default(uuid())
  atendimentoId    String
  /// Data/hora do registro da evolução
  dataHora         DateTime
  evolucao         String
  /// Categoria profissional: MEDICO, ENFERMEIRO, NUTRICAO, FISIOTERAPIA, PSICOLOGIA, FARMACIA, OUTRO
  categoria        String?
  nomeProfissional String?
  conselho         String?
  registradoPorId  String?
  createdAt        DateTime  @default(now())
  atendimento      Atendimento @relation(fields: [atendimentoId], references: [id], onDelete: Cascade)

  @@index([atendimentoId])
  @@index([dataHora])
  @@map("evolucoes_multiprofissional")
}

/// Folha de internação e alta hospitalar em obstetrícia — uma por atendimento
model FichaInternacaoObstetrica {
  id               String    @id @default(uuid())
  atendimentoId    String    @unique
  nomePaciente     String?
  numeroProntuario String?
  leitoDescricao   String?
  /// Campos de texto da folha: identificação, responsável, atenção médica, exame físico, etc.
  campos           Json?
  /// Evolução do trabalho de parto (lista de linhas)
  trabalhoParto    Json?
  /// Evolução do puerpério (lista de linhas)
  puerperio        Json?
  /// Recém-nascido (campos)
  recemNascido     Json?
  /// Condições de alta (campos + checkboxes)
  condicoesAlta    Json?
  preenchidoPorId  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  atendimento      Atendimento @relation(fields: [atendimentoId], references: [id], onDelete: Cascade)

  @@index([atendimentoId])
  @@map("fichas_internacao_obstetrica")
}

/// Ficha médica de berçário (recém-nascido) — uma por atendimento
model FichaBercario {
  id               String    @id @default(uuid())
  atendimentoId    String    @unique
  nomePaciente     String?
  numeroProntuario String?
  leitoDescricao   String?
  /// Identificação do RN, filiação, antecedentes pré-natais, exame clínico
  campos           Json?
  /// Evolução / prescrição / enfermagem (log cronológico)
  evolucao         Json?
  preenchidoPorId  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  atendimento      Atendimento @relation(fields: [atendimentoId], references: [id], onDelete: Cascade)

  @@index([atendimentoId])
  @@map("fichas_bercario")
}

/// Encaminhamento interno, externo ou solicitação de internação
model Encaminhamento {
  id              String             @id @default(uuid())
  prontuarioId    String
  tipo            TipoEncaminhamento
  /// Especialidade de destino (ex: "Cardiologia", "UTI")
  especialidade   String
  /// Para encaminhamento interno: ID do médico de destino
  medicoDestinoId String?
  /// Alta, Média, Baixa
  prioridade      String?
  /// Resumo clínico para o receptor
  resumoClinco    String?
  /// Justificativa (obrigatória para externos)
  justificativa   String?
  /// Para internação: CID informado pelo médico (leito/apartamento é definido pela enfermagem em Admissões)
  cidInternacao   String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  prontuario      ProntuarioMedico   @relation(fields: [prontuarioId], references: [id], onDelete: Cascade)

  @@index([prontuarioId])
  @@map("encaminhamentos")
}

/// Log de auditoria imutável — registra toda alteração no sistema
/// NUNCA deve ter UPDATE ou DELETE — apenas INSERT
model LogAuditoria {
  id            String            @id @default(uuid())
  usuarioId     String?
  acao          TipoAcaoAuditoria
  /// Entidade afetada: "Paciente", "Triagem", "Prescricao", etc.
  entidade      String
  entidadeId    String?
  /// Campo alterado (para ações de atualização)
  campo         String?
  /// Valor anterior (para ações de atualização)
  valorAnterior String?
  /// Novo valor (para ações de atualização)
  valorNovo     String?
  /// IP da requisição
  ipOrigem      String?
  /// User-Agent do cliente
  userAgent     String?
  registradoEm  DateTime          @default(now())
  usuario       Usuario?          @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@index([entidade, entidadeId])
  @@index([registradoEm])
  @@map("logs_auditoria")
}

/// Configurações gerais da instituição / Município
model Instituicao {
  id                  String   @id @default(uuid())
  nomeMunicipio       String
  nomeInstituicao     String
  /// Cadastro Nacional de Estabelecimentos de Saúde (7 dígitos)
  cnes                String?
  /// Código IBGE do município gestor (7 dígitos)
  codigoIbgeMunicipio String?
  endereco            String?
  bairro              String?
  cidade              String?
  estado              String?  @db.Char(2)
  cep                 String?
  logomarcaUrl        String?
  /// Habilita busca/autopreenchimento automático de medicamentos e materiais nas telas de cadastro
  buscaAutomaticaCatalogo Boolean @default(true)
  updatedAt           DateTime @updatedAt

  @@map("instituicoes")
}

/// Configurações do Painel de Chamadas
model ConfigPainel {
  id                      String   @id @default(uuid())
  vozAtiva                Boolean  @default(true)
  tipoVoz                 String   @default("feminina") // "masculina" | "feminina"
  corPrimaria             String   @default("#2563eb")
  corSecundaria           String   @default("#f8fafc")
  corTexto                String   @default("#1e293b")
  mensagemPadrao          String   @default("Comparecer ao consultório")
  velocidadeVoz           Float    @default(1.0)
  /// Tela dividida: mídia rotativa + chamadas
  layoutDividido          Boolean  @default(false)
  /// Intervalo entre imagens (segundos)
  intervaloRotacaoSegundos Int     @default(8)
  /// "esquerda" | "direita" — posição da área de mídia
  posicaoMidia            String   @default("esquerda")
  /// [{ id, url, titulo?, legenda?, ordem? }]
  imagensRotativas        Json     @default("[]")
  updatedAt               DateTime @updatedAt

  @@map("config_painel")
}

/// Configuração SMTP (linha única `id = default`)
model ConfigSmtp {
  id                 String   @id
  host               String   @default("")
  porta              Int      @default(587)
  secure             Boolean  @default(false)
  usuario            String   @default("")
  senhaCriptografada String   @default("")
  emailRemetente     String   @default("")
  nomeRemetente      String?
  ativo              Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("config_smtp")
}

/// Origem do paciente (Demanda espontânea, SAMU, Transferência)
model OrigemPaciente {
  id                String        @id @default(uuid())
  descricao         String        @unique
  ativo             Boolean       @default(true)
  createdAt         DateTime      @default(now())
  /// Quadrícula “procedência” na ficha de urgência (configurável em Origens)
  procedenciaFicha  String?
  atendimentos      Atendimento[]

  @@map("origens_pacientes")
}

/// Roles de acesso do sistema (RBAC)
enum Role {
  ADMIN
  MEDICO
  ENFERMEIRO
  TECNICO_ENFERMAGEM
  RECEPCIONISTA
  DIRETOR_CLINICO
  FARMACEUTICO
}

// =============================================================================
// FARMÁCIA HOSPITALAR (tabelas tb_* — especificação conceitual)
// =============================================================================

/// Catálogo de medicamentos e controle de saldo (estoque local)
model TbMedicamento {
  id            String   @id @default(uuid())
  nome          String
  /// Princípio ativo (normalizado) — base para matriz de interação
  principioAtivo String
  forma         String?
  concentracao  String?
  unidade       String?
  /// Código de barras EAN/GTIN
  codigoEan     String?
  /// Registro na ANVISA
  codigoAnvisa  String?
  classeTerapeutica String?
  viaAdministracao  String?
  /// Medicamento de Alta Vigilância (MAV)
  mav           Boolean  @default(false)
  /// Exige dupla checagem à beira leito
  duplaChecagem Boolean  @default(false)
  /// Tipo de controle/retenção de receita (ex: Portaria 344)
  tipoControle  String?
  alertasAlergia String?
  localizacaoFisica String?
  temperaturaArmazenamento String?
  /// Saldos: manter >= 0 (validação também no app; constraints via SQL)
  saldoAtual    Int      @default(0)
  saldoReservado Int     @default(0)
  /// Alerta quando saldoAtual <= estoqueMinimo
  estoqueMinimo Int      @default(0)
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  itens         TbPrescricaoItem[]
  sinonimos     TbMedicamentoSinonimo[]
  lotes         TbMedicamentoLote[]
  movimentacoes TbFarmaciaMovimentacao[]
  entradasNfItens TbFarmaciaEntradaNfItem[]
  saidasItens     TbFarmaciaSaidaItem[]

  @@index([principioAtivo])
  @@index([nome])
  @@map("tb_medicamento")
}

/// Lote de medicamento — controle por validade (FEFO)
model TbMedicamentoLote {
  id            String    @id @default(uuid())
  medicamentoId String
  lote          String
  validade      DateTime?
  quantidade    Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  medicamento   TbMedicamento             @relation(fields: [medicamentoId], references: [id], onDelete: Cascade)
  entradasItens TbFarmaciaEntradaNfItem[]
  saidasItens   TbFarmaciaSaidaItem[]
  movimentacoes TbFarmaciaMovimentacao[]

  @@unique([medicamentoId, lote])
  @@index([medicamentoId])
  @@index([validade])
  @@map("tb_medicamento_lote")
}

enum TipoMovimentacaoFarmacia {
  ENTRADA_NF
  ENTRADA_SEM_NOTA
  EMPRESTIMO_ENTRADA
  DEVOLUCAO_PACIENTE
  OUTRAS_ENTRADAS
  ENTRADA_MANUAL
  SAIDA_DISPENSACAO
  SAIDA_SEM_NOTA
  EMPRESTIMO_SAIDA
  PERDA_AVARIA_VALIDADE
  DEVOLUCAO_FORNECEDOR
  OUTRAS_SAIDAS
  SAIDA_MANUAL
  AJUSTE
}

/// Livro-razão de movimentações de estoque
model TbFarmaciaMovimentacao {
  id             String                   @id @default(uuid())
  medicamentoId  String
  loteId         String?
  tipo           TipoMovimentacaoFarmacia
  /// Positivo = entrada, negativo = saída
  quantidade     Int
  saldoAnterior  Int
  saldoPosterior Int
  referenciaTipo String?
  referenciaId   String?
  usuarioId      String?
  observacoes    String?
  createdAt      DateTime                 @default(now())

  medicamento    TbMedicamento     @relation(fields: [medicamentoId], references: [id])
  lote           TbMedicamentoLote? @relation(fields: [loteId], references: [id])

  @@index([medicamentoId])
  @@index([loteId])
  @@index([tipo])
  @@index([createdAt])
  @@map("tb_farmacia_movimentacao")
}

/// Sinônimos/abreviações para matching (ex.: "AAS" -> "ácido acetilsalicílico")
model TbMedicamentoSinonimo {
  id            String   @id @default(uuid())
  medicamentoId String
  /// Texto do sinônimo (qualquer forma digitada pelo usuário, ex.: "AAS")
  sinonimo      String
  /// Texto normalizado para busca (sem acentos, lowercase, espaços colapsados)
  sinonimoNorm  String
  ativo         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  medicamento   TbMedicamento @relation(fields: [medicamentoId], references: [id], onDelete: Cascade)

  @@index([sinonimoNorm])
  @@index([medicamentoId])
  @@unique([medicamentoId, sinonimoNorm])
  @@map("tb_medicamento_sinonimo")
}

/// Matriz de risco de interação entre princípios ativos (pares normalizados)
model TbInteracaoMatriz {
  id               String         @id @default(uuid())
  principioAtivoA  String
  principioAtivoB  String
  risco            RiscoInteracao
  efeitoClinico    String
  sugestaoSistema  String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([principioAtivoA, principioAtivoB])
  @@index([risco])
  @@map("tb_interacao_matriz")
}

/// Prescrição hospitalar (cabeçalho) integrada à farmácia
model TbPrescricaoCabecalho {
  id                String                 @id @default(uuid())
  atendimentoId     String
  criadoPorId       String
  statusValidacao   StatusValidacaoFarmacia @default(AGUARDANDO_TRIAGEM)
  observacoes       String?
  ativa             Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  atendimento       Atendimento            @relation(fields: [atendimentoId], references: [id], onDelete: Cascade)
  criadoPor         Usuario                @relation(fields: [criadoPorId], references: [id])
  itens             TbPrescricaoItem[]

  @@index([atendimentoId])
  @@index([statusValidacao])
  @@map("tb_prescricao_cabecalho")
}

/// Item da prescrição hospitalar (medicamento) — sujeito à triagem da farmácia
model TbPrescricaoItem {
  id                   String                 @id @default(uuid())
  prescricaoId         String
  medicamentoId        String?
  /// Snapshot: permite prescrever mesmo sem cadastro no catálogo
  medicamentoNome      String
  principioAtivo       String
  /// Quantidade solicitada (unidade do catálogo). Para estoque simplificado.
  quantidadeSolicitada Int                    @default(1)
  dose                 String
  via                  ViaAdministracao
  frequencia           String
  duracaoDias          Int?
  observacoes          String?
  /// Justificativa médica obrigatória quando há interação CRÍTICA e o médico decide prosseguir
  justificativaMedica  String?
  /// Snapshot dos alertas de interação (para triagem farmacêutica e auditoria clínica)
  alertasInteracao     Json?
  statusValidacao      StatusValidacaoFarmacia @default(AGUARDANDO_TRIAGEM)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  prescricao           TbPrescricaoCabecalho  @relation(fields: [prescricaoId], references: [id], onDelete: Cascade)
  medicamento          TbMedicamento?         @relation(fields: [medicamentoId], references: [id])
  dispensacao          TbFarmaciaDispensacao?
  saidas               TbFarmaciaSaidaItem[]

  @@index([prescricaoId])
  @@index([principioAtivo])
  @@index([statusValidacao])
  @@map("tb_prescricao_item")
}

/// Triagem/dispensação na farmácia (por item)
model TbFarmaciaDispensacao {
  id              String                  @id @default(uuid())
  itemId          String                  @unique
  validadoPorId   String?
  status          StatusValidacaoFarmacia @default(AGUARDANDO_TRIAGEM)
  motivoRejeicao  String?
  validadoEm      DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  item            TbPrescricaoItem        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  validadoPor     Usuario?                @relation(fields: [validadoPorId], references: [id])
  saidas          TbFarmaciaSaidaItem[]

  @@index([status])
  @@index([validadoEm])
  @@map("tb_farmacia_dispensacao")
}

enum TipoEntradaFarmacia {
  ENTRADA_NF
  ENTRADA_SEM_NOTA
  EMPRESTIMO_ENTRADA
  DEVOLUCAO_PACIENTE
  OUTRAS_ENTRADAS
}

/// Cadastro de Fornecedores de Medicamentos e Insumos
model TbFornecedor {
  id                String   @id @default(uuid())
  razaoSocial       String
  nomeFantasia      String?
  cnpj              String   @unique
  inscricaoEstadual String?
  telefone          String?
  email             String?
  endereco          String?
  cidade            String?
  uf                String?
  ativo             Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  entradasNf        TbFarmaciaEntradaNf[]

  @@index([razaoSocial])
  @@index([cnpj])
  @@map("tb_fornecedores")
}

/// Entrada de estoque (Nota Fiscal, avulsa sem nota, empréstimo, devolução)
model TbFarmaciaEntradaNf {
  id             String              @id @default(uuid())
  tipo           TipoEntradaFarmacia @default(ENTRADA_NF)
  numeroNota     String
  serie          String?
  fornecedorId   String?
  fornecedorNome String?
  fornecedorCnpj String?
  emitidaEm      DateTime?
  recebidaEm     DateTime @default(now())
  /// Indica se a entrada foi importada de XML NF-e
  importadaXml   Boolean  @default(false)
  chaveNfe       String?
  observacoes    String?
  criadoPorId    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  fornecedor     TbFornecedor?             @relation(fields: [fornecedorId], references: [id])
  criadoPor      Usuario?                  @relation(fields: [criadoPorId], references: [id])
  itens          TbFarmaciaEntradaNfItem[]

  @@index([tipo])
  @@index([numeroNota])
  @@index([recebidaEm])
  @@map("tb_farmacia_entrada_nf")
}

model TbFarmaciaEntradaNfItem {
  id            String   @id @default(uuid())
  entradaId     String
  medicamentoId String
  loteId        String?
  quantidade    Int
  custoUnitario Decimal? @db.Decimal(12, 2)
  lote          String?
  validade      DateTime?
  createdAt     DateTime @default(now())

  entrada       TbFarmaciaEntradaNf @relation(fields: [entradaId], references: [id], onDelete: Cascade)
  medicamento   TbMedicamento       @relation(fields: [medicamentoId], references: [id])
  loteRef       TbMedicamentoLote?  @relation(fields: [loteId], references: [id])

  @@index([entradaId])
  @@index([medicamentoId])
  @@index([loteId])
  @@map("tb_farmacia_entrada_nf_item")
}

enum TipoSaidaFarmacia {
  DISPENSACAO_PRESCRICAO
  SAIDA_SEM_NOTA
  EMPRESTIMO_SAIDA
  PERDA_AVARIA_VALIDADE
  DEVOLUCAO_FORNECEDOR
  OUTRAS_SAIDAS
  BAIXA_MANUAL
}

/// Saída de estoque (dispensação ou baixa manual)
model TbFarmaciaSaida {
  id             String           @id @default(uuid())
  tipo           TipoSaidaFarmacia
  atendimentoId  String?
  observacoes    String?
  criadoPorId    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  criadoPor      Usuario?               @relation(fields: [criadoPorId], references: [id])
  atendimento    Atendimento?           @relation(fields: [atendimentoId], references: [id])
  itens          TbFarmaciaSaidaItem[]

  @@index([tipo])
  @@index([createdAt])
  @@index([atendimentoId])
  @@map("tb_farmacia_saida")
}

model TbFarmaciaSaidaItem {
  id               String   @id @default(uuid())
  saidaId          String
  medicamentoId    String
  loteId           String?
  quantidade       Int
  motivo           String?
  dispensacaoId    String?
  prescricaoItemId String?
  createdAt        DateTime @default(now())

  saida            TbFarmaciaSaida        @relation(fields: [saidaId], references: [id], onDelete: Cascade)
  medicamento      TbMedicamento          @relation(fields: [medicamentoId], references: [id])
  loteRef          TbMedicamentoLote?     @relation(fields: [loteId], references: [id])
  dispensacao      TbFarmaciaDispensacao? @relation(fields: [dispensacaoId], references: [id])
  prescricaoItem   TbPrescricaoItem?      @relation(fields: [prescricaoItemId], references: [id])

  @@index([saidaId])
  @@index([medicamentoId])
  @@index([loteId])
  @@index([dispensacaoId])
  @@index([prescricaoItemId])
  @@map("tb_farmacia_saida_item")
}

/// Auditoria LGPD (imutável) — registrar leituras e mudanças de status na farmácia
model TbAuditoriaLog {
  id            String    @id @default(uuid())
  usuarioId     String?
  role          Role?
  atendimentoId String?
  acao          String
  entidade      String
  entidadeId    String?
  ipOrigem      String?
  userAgent     String?
  detalhes      Json?
  registradoEm  DateTime  @default(now())

  usuario       Usuario?  @relation(fields: [usuarioId], references: [id])
  atendimento   Atendimento? @relation(fields: [atendimentoId], references: [id])

  @@index([usuarioId])
  @@index([atendimentoId])
  @@index([entidade, entidadeId])
  @@index([registradoEm])
  @@map("tb_auditoria_log")
}

