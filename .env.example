# =============================================================================
# SGH — Sistema de Gerenciamento Hospitalar
# Arquivo de variáveis de ambiente — COPIE PARA .env E PREENCHA OS VALORES
# =============================================================================

# -----------------------------------------------------------------------------
# BANCO DE DADOS (PostgreSQL)
# -----------------------------------------------------------------------------
# Exemplo local:     postgresql://usuario:senha@localhost:5432/sgh_db
# Exemplo Supabase:  postgresql://postgres:[senha]@db.[ref].supabase.co:5432/postgres
# Exemplo Neon:      postgresql://usuario:senha@ep-xxx.us-east-1.aws.neon.tech/sgh_db
# Padrão alinhado ao docker-compose.yml (senha postgres = "senha", porta 5432):
# npm run db:compose:up  →  depois npm run db:push  e npm run db:seed
DATABASE_URL="postgresql://postgres:senha@127.0.0.1:5432/sgh_db"
# Postgres só no Windows sem Docker — use porta/senha do seu cluster:
#DATABASE_URL="postgresql://postgres:SUA_SENHA@127.0.0.1:5433/sgh_db"
# Desabilitar cheque automático antes do dev (CI / só frontend):
# SKIP_DATABASE_ENSURE=1
#
# Desenvolvimento local com .env da VPS: copie este bloco para .env.local
# (o .env.local sobrescreve o .env — veja scripts/load-env.mjs)
#DATABASE_URL="postgresql://postgres:senha@127.0.0.1:5432/sgh_db"
#NEXTAUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# NEXTAUTH
# -----------------------------------------------------------------------------
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET="sua-chave-secreta-aqui-gere-com-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# CRIPTOGRAFIA AES-256 (dados sensíveis do paciente)
# -----------------------------------------------------------------------------
# Gere com: openssl rand -hex 32 (deve ter exatamente 64 caracteres hex)
ENCRYPTION_KEY="sua-chave-hex-de-64-caracteres-aqui-gere-com-openssl-rand-hex-32"

# -----------------------------------------------------------------------------
# PUSHER (WebSockets — Painel de Chamada + Triagem em tempo real)
# -----------------------------------------------------------------------------
# Crie conta gratuita em https://pusher.com → New App → selecione cluster
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="us2"

# Variáveis públicas (expostas no cliente)
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="us2"

# -----------------------------------------------------------------------------
# UPLOAD DE ARQUIVOS
# -----------------------------------------------------------------------------
# Diretório local para armazenar uploads (relatório ao .gitignore)
UPLOAD_DIR="./uploads"
# Tamanho máximo de arquivo em bytes (padrão: 10MB)
MAX_FILE_SIZE="10485760"

# -----------------------------------------------------------------------------
# CONFIGURAÇÕES DO HOSPITAL
# -----------------------------------------------------------------------------
HOSPITAL_NOME="Hospital Municipal"
HOSPITAL_CNPJ=""
HOSPITAL_ENDERECO=""
HOSPITAL_TELEFONE=""
HOSPITAL_LOGO_URL=""

# -----------------------------------------------------------------------------
# LOGS
# -----------------------------------------------------------------------------
LOG_LEVEL="info"
NODE_ENV="development"
