{
  "name": "sgh",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/run-prisma.mjs generate",
    "clean:next": "node scripts/clean-next.mjs",
    "db:compose:up": "docker compose up -d db",
    "db:compose:down": "docker compose down",
    "db:ensure": "node scripts/ensure-database.mjs",
    "dev": "node scripts/ensure-database.mjs && node ./node_modules/next/dist/bin/next dev --webpack -p 3002",
    "dev:only": "node ./node_modules/next/dist/bin/next dev --webpack -p 3002",
    "stack": "npm run db:bootstrap && npm run dev",
    "dev:turbo": "node ./node_modules/next/dist/bin/next dev -p 3002",
    "build": "node ./node_modules/next/dist/bin/next build",
    "build:release": "node ./node_modules/next/dist/bin/next build && node scripts/package-release.mjs",
    "build:instalador": "node ./node_modules/next/dist/bin/next build && node scripts/package-release.mjs && npm run db:update:sql && node scripts/package-instalador.mjs",
    "db:schema:sql": "node ./node_modules/prisma/build/index.js migrate diff --from-empty --to-schema prisma/schema.prisma --script -o database/sgh_schema_completo.sql",
    "db:update:sql": "npm run db:schema:sql && node scripts/generate-update-sql.mjs && node scripts/generate-banco-completo.mjs",
    "db:full:sql": "node scripts/generate-banco-completo.mjs",
    "start": "PORT=3002 node .next/standalone/server.js || node scripts/start.mjs",
    "lint": "node ./node_modules/next/dist/bin/next lint",
    "test": "node ./node_modules/vitest/vitest.mjs",
    "test:run": "node ./node_modules/vitest/vitest.mjs run",
    "test:ui": "node ./node_modules/vitest/vitest.mjs --ui",
    "db:generate": "node scripts/run-prisma.mjs generate",
    "db:migrate": "node scripts/run-prisma.mjs migrate dev",
    "db:migrate:baseline": "node scripts/baseline-migrations.mjs",
    "db:migrate:deploy": "node scripts/run-prisma.mjs migrate deploy",
    "db:migrate:status": "node scripts/run-prisma.mjs migrate status",
    "db:push": "node scripts/run-prisma.mjs db push",
    "db:studio": "node scripts/run-prisma.mjs studio",
    "db:seed": "node scripts/run-tsx.mjs prisma/seed.ts",
    "db:constraints": "node scripts/run-prisma.mjs db execute --file prisma/migrations/20260528204500_farmacia_constraints/migration.sql && node scripts/run-prisma.mjs db execute --file prisma/migrations/20260615120000_farmacia_lotes_movimentacao/migration.sql",
    "db:seed:sql": "node scripts/run-tsx.mjs scripts/generate-seed-sql.ts",
    "db:bootstrap": "node scripts/init-sgh-database.mjs",
    "smoke:rbac": "node scripts/smoke-rbac.mjs",
    "deploy:prod": "bash scripts/deploy-producao.sh",
    "deploy:prod:ps": "powershell -ExecutionPolicy Bypass -File scripts/deploy-producao.ps1"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.5",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.5",
    "@radix-ui/react-dropdown-menu": "^2.1.5",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.5",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-radio-group": "^1.2.2",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-select": "^2.1.5",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.5",
    "@radix-ui/react-tooltip": "^1.1.7",
    "axios": "^1.8.4",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "date-fns": "^4.1.0",
    "isomorphic-dompurify": "^2.23.0",
    "lucide-react": "^0.469.0",
    "next": "^16.2.4",
    "next-auth": "^4.24.11",
    "next-themes": "^0.4.4",
    "nodemailer": "^6.9.16",
    "pdf-lib": "^1.17.1",
    "pg": "^8.20.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "pusher": "^5.2.0",
    "pusher-js": "^8.4.0",
    "radix-ui": "^1.6.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.54.2",
    "react-input-mask": "^2.0.4",
    "recharts": "^3.8.1",
    "shadcn": "^4.11.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.0.1",
    "dotenv": "^16.4.7",
    "eslint": "^8",
    "eslint-config-next": "14.2.29",
    "postcss": "^8",
    "prisma": "^7.8.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
